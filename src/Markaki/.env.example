# Endereço da API usado pelo app. Copie este arquivo para .env (o iniciar.bat faz isso).
# O .env não vai para o Git. Reinicie o Expo depois de mudar o valor.
#
# Navegador ou emulador iOS na mesma máquina: http://localhost:3000/api
# Emulador Android:                         http://10.0.2.2:3000/api
# Celular físico (mesma rede Wi-Fi):        http://IP_DO_COMPUTADOR:3000/api
#   (descubra o IP com "ipconfig" no Windows, linha "Endereço IPv4"; a API
#    precisa de HOST=0.0.0.0 no backend/.env)
# Demonstração hospedada:                   https://SEU-SERVICO.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api
