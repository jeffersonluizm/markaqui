# Configuração da API. Copie para .env (o iniciar.bat faz isso e gera o JWT_SECRET).
# O .env não vai para o Git. Variáveis de ambiente do sistema valem por cima deste arquivo.

# Segredo dos tokens de sessão: texto aleatório com 32 caracteres ou mais.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3000

# Interface de rede: 127.0.0.1 (só esta máquina, padrão) ou 0.0.0.0 (o celular na
# mesma rede alcança a API, que fica visível para a rede local; também na hospedagem).
HOST=127.0.0.1

# Arquivo do SQLite (padrão: backend/dados/markaqui.db).
# DB_FILE=

# Origens liberadas no CORS: o endereço do app web (local ou hospedado).
CORS_ORIGENS=http://localhost:8081,http://localhost:19006

# Proxies na frente da API (1 no Render), para o limite de tentativas valer por visitante.
TRUST_PROXY=0

# Consultas futuras ativas por paciente.
LIMITE_CONSULTAS_ATIVAS=3

# Modo demonstração: cria as contas "Entrar como paciente / clínica" e expõe
# GET /api/demo. Use só com um banco exclusivo de demonstração.
DEMO_ENABLED=false
# Minutos entre os resets dos dados de demonstração (0 = só quando o banco está vazio).
DEMO_RESET_MINUTOS=0
# E-mails e senhas das contas demo. Sem senha, uma senha forte é gerada a cada partida.
DEMO_PACIENTE_EMAIL=paciente@markaqui.demo
DEMO_PACIENTE_SENHA=
DEMO_GESTOR_EMAIL=gestor@markaqui.demo
DEMO_GESTOR_SENHA=
