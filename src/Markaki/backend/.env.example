# Configuração da API. Copie para .env (o iniciar.bat faz isso e gera o JWT_SECRET).
# O .env não vai para o Git. Variáveis de ambiente do sistema valem por cima deste arquivo.

# Segredo dos tokens de sessão: texto aleatório com 32 caracteres ou mais.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3000

# Fuso da clínica: "hoje" e "agora" da agenda (padrão America/Sao_Paulo, qualquer que seja o fuso do servidor).
FUSO_HORARIO=America/Sao_Paulo

# Interface de rede: 127.0.0.1 (só esta máquina, padrão) ou 0.0.0.0 (o celular na
# mesma rede alcança a API, que fica visível para a rede local; também na hospedagem).
HOST=127.0.0.1

# Arquivo do SQLite (padrão: backend/dados/markaqui.db).
# DB_FILE=

# Origens liberadas no CORS: o endereço do app web (local ou hospedado).
CORS_ORIGENS=http://localhost:8081,http://localhost:19006

# Proxies na frente da API (1 no Render), para o limite de tentativas valer por visitante.
TRUST_PROXY=0

# Consultas futuras ativas por paciente.
LIMITE_CONSULTAS_ATIVAS=3

# Itens por listagem (horários, consultas, médicos).
LIMITE_LISTAGEM=500

# Modo demonstração: "Entrar como paciente / clínica" sem senha (GET /api/demo e
# POST /api/demo/entrar). Use só com um banco exclusivo de demonstração.
DEMO_ENABLED=false
# Minutos entre os resets dos dados de demonstração (0 = só quando o banco está vazio).
DEMO_RESET_MINUTOS=0
# Cada "Entrar como paciente" cria uma paciente efêmera; acima deste teto, a mais antiga sai.
DEMO_MAX_VISITANTES=50
# ...mas só sai a visitante com pelo menos estes minutos; se todas são mais novas, a demo
# responde 503 (cheia) com Retry-After.
DEMO_VIDA_MINIMA_MINUTOS=15
# Contas temporárias vivas por IP (o mesmo IP perde a própria mais antiga) e
# horários que um mesmo IP cria com o gestor demo.
DEMO_VISITANTES_POR_IP=3
DEMO_HORARIOS_POR_IP=100
# Tetos do que os visitantes criam como clínica (o cenário de exemplo conta).
DEMO_MAX_MEDICOS=20
DEMO_MAX_HORARIOS=500
# Horários novos só nos próximos N dias; horários do cenário bloqueados ao mesmo tempo.
DEMO_JANELA_DIAS=60
DEMO_MAX_BLOQUEADOS=20
# "Entrar como" por IP por minuto.
DEMO_ENTRADAS_POR_MINUTO=10
# E-mail do gestor de demonstração (não tem senha; só se entra pela demonstração).
DEMO_GESTOR_EMAIL=gestor@markaqui.demo
