{
  "name": "markaqui-api",
  "version": "1.0.0",
  "description": "API do Markaqui: agendamento de consultas em clínica médica",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "semear": "node --env-file-if-exists=.env scripts/semear.js",
    "criar-gestor": "node --env-file-if-exists=.env scripts/criar-gestor.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test \"test/*.test.js\"",
    "carga": "node carga/executar.js",
    "lint": "eslint .",
    "formatar": "prettier --write .",
    "formato": "prettier --check ."
  },
  "keywords": [
    "express",
    "api",
    "crud",
    "medicos",
    "agendamentos"
  ],
  "author": "Equipe Markaqui (PUC Minas, ADS)",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
