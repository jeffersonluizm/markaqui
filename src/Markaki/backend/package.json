{
  "name": "markaqui-api",
  "version": "1.0.0",
  "description": "API do Markaqui: agendamento de consultas em clínica médica",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "semear": "node --env-file-if-exists=.env scripts/semear.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test \"test/*.test.js\"",
    "carga": "node carga/executar.js"
  },
  "keywords": [
    "express",
    "api",
    "crud",
    "medicos",
    "agendamentos"
  ],
  "author": "Equipe Markaqui (PUC Minas, ADS)",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "supertest": "^7.3.1"
  }
}
